# ============================================================================
# Daily AI News — environment variables
# Copy to .env.local for dev. On Vercel, set via `vercel env` or dashboard.
# ============================================================================

# --- Auth -------------------------------------------------------------------
# Single shared password for dashboard access (private deployment).
DASHBOARD_PASSWORD="change-me"
# 32+ char secret used to sign the session JWT.
AUTH_SECRET="replace-with-openssl-rand-hex-32"

# --- Cron security ----------------------------------------------------------
# Vercel injects this automatically in prod when you configure a cron. Use a
# strong random value locally to protect the endpoint.
CRON_SECRET="replace-with-openssl-rand-hex-32"

# --- AI Gateway -------------------------------------------------------------
# Uses Vercel AI Gateway by default; auto-injected in Vercel deployments.
# For local dev, create a gateway API key in the Vercel dashboard:
#   https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=""
# Model in "provider/model" form routed through the gateway.
AI_MODEL="anthropic/claude-sonnet-4-6"

# --- Storage (Vercel Blob) --------------------------------------------------
# Auto-injected on Vercel. For local dev, create a Blob store and paste token:
#   https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# --- Optional: extra news sources ------------------------------------------
# NewsAPI key (https://newsapi.org) — fallback source, optional.
NEWSAPI_KEY=""
